            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"birthDate\": \"1995-08-15\",\n    \"birthTime\": \"14:30:00\",\n    \"timeAccuracy\": \"EXACT\",\n    \"birthPlaceName\": \"Mumbai, Maharashtra, India\",\n    \"latitude\": 19.076,\n    \"longitude\": 72.8777,\n    \"timezone\": \"Asia/Kolkata\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/me/birth-details",
              "host": ["{{baseUrl}}"],
