          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"birthDate\": \"1995-08-15\",\n    \"timeAccuracy\": \"UNKNOWN\",\n    \"birthPlaceName\": \"Varanasi, India\",\n    \"latitude\": 25.3176,\n    \"longitude\": 82.9739,\n    \"timezone\": \"Asia/Kolkata\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/me/birth-details",
