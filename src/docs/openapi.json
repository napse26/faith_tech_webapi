{
  "openapi": "3.0.3",
  "info": {
    "title": "DharmaDarshan - Astrology & Customer Management API",
    "version": "1.0.0",
    "description": "Production-ready, developer-ready REST API for DharmaDarshan mobile OTP authentication, customer profile management, multiple birth profiles, customer wallet balance, preferences, sessions, and security lifecycle. Powered by Node.js, Express, Prisma, and PostgreSQL (Supabase)."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local Development Server"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ApiResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "message": { "type": "string" },
          "data": { "type": "object", "nullable": true },
          "error": {
            "type": "object",
            "properties": {
              "code": { "type": "string" },
              "details": { "nullable": true }
            }
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": { "type": "string" },
                "field": { "type": "string" },
                "message": { "type": "string" }
              }
            }
          },
          "traceId": { "type": "string" }
        }
      },
      "CustomerWallet": {
        "type": "object",
        "properties": {
          "balance": { "type": "number", "example": 250.75 },
          "currency": { "type": "string", "example": "INR" }
        }
      },
      "CustomerProfile": {
        "type": "object",
        "properties": {
          "customerId": { "type": "string", "example": "101" },
          "fullName": { "type": "string", "nullable": true, "example": "Sunil Kumar" },
          "email": { "type": "string", "nullable": true, "example": "sunil@example.com" },
          "mobileNumber": { "type": "string", "example": "+919876543210" },
          "mobileVerified": { "type": "boolean", "example": true },
          "emailVerified": { "type": "boolean", "example": false },
          "profilePhotoUrl": { "type": "string", "nullable": true, "example": null },
          "dateOfBirth": { "type": "string", "nullable": true, "example": "1990-01-15" },
          "gender": { "type": "string", "nullable": true, "example": "MALE" },
          "preferredLanguage": { "type": "string", "example": "hi" },
          "accountStatus": { "type": "string", "example": "ACTIVE" },
          "profileCompletionPercentage": { "type": "integer", "example": 80 },
          "wallet": { "$ref": "#/components/schemas/CustomerWallet" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "UpdateCustomerProfileRequest": {
        "type": "object",
        "properties": {
          "fullName": { "type": "string", "example": "Sunil Kumar" },
          "email": { "type": "string", "example": "sunil@example.com" },
          "dateOfBirth": { "type": "string", "example": "1990-01-15" },
          "gender": { "type": "string", "enum": ["MALE", "FEMALE", "NON_BINARY", "OTHER", "PREFER_NOT_TO_SAY"], "example": "MALE" },
          "preferredLanguage": { "type": "string", "example": "hi" }
        }
      },
      "ProfileStatus": {
        "type": "object",
        "properties": {
          "accountStatus": { "type": "string", "example": "ACTIVE" },
          "profileCompletionPercentage": { "type": "integer", "example": 80 },
          "missingFields": {
            "type": "array",
            "items": { "type": "string" },
            "example": ["email", "profilePhoto"]
          },
          "canUseAstrologyServices": { "type": "boolean", "example": true },
          "wallet": { "$ref": "#/components/schemas/CustomerWallet" }
        }
      },
      "BirthPlace": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "example": "Jaunpur, Uttar Pradesh, India" },
          "latitude": { "type": "number", "nullable": true, "example": 25.7464 },
          "longitude": { "type": "number", "nullable": true, "example": 82.6837 },
          "timezone": { "type": "string", "example": "Asia/Kolkata" }
        }
      },
      "BirthProfile": {
        "type": "object",
        "properties": {
          "profileId": { "type": "string", "example": "1" },
          "profileName": { "type": "string", "example": "Self" },
          "relationship": { "type": "string", "enum": ["SELF", "SPOUSE", "CHILD", "MOTHER", "FATHER", "SIBLING", "OTHER"], "example": "SELF" },
          "gender": { "type": "string", "nullable": true, "example": "MALE" },
          "dateOfBirth": { "type": "string", "example": "1990-01-15" },
          "timeOfBirth": { "type": "string", "nullable": true, "example": "08:30:00" },
          "birthTimeAccuracy": { "type": "string", "enum": ["EXACT", "APPROXIMATE", "UNKNOWN"], "example": "EXACT" },
          "birthPlace": { "$ref": "#/components/schemas/BirthPlace" },
          "isDefault": { "type": "boolean", "example": true },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "CreateBirthProfileRequest": {
        "type": "object",
        "required": ["profileName", "dateOfBirth", "birthPlace"],
        "properties": {
          "profileName": { "type": "string", "example": "Self" },
          "relationship": { "type": "string", "enum": ["SELF", "SPOUSE", "CHILD", "MOTHER", "FATHER", "SIBLING", "OTHER"], "default": "SELF" },
          "gender": { "type": "string", "enum": ["MALE", "FEMALE", "OTHER"], "example": "MALE" },
          "dateOfBirth": { "type": "string", "example": "1990-01-15" },
          "timeOfBirth": { "type": "string", "nullable": true, "example": "08:30:00" },
          "birthTimeAccuracy": { "type": "string", "enum": ["EXACT", "APPROXIMATE", "UNKNOWN"], "default": "EXACT" },
          "birthPlace": { "$ref": "#/components/schemas/BirthPlace" },
          "isDefault": { "type": "boolean", "default": false }
        }
      },
      "CustomerPreferences": {
        "type": "object",
        "properties": {
          "language": { "type": "string", "example": "hi" },
          "preferredAstrologerLanguage": { "type": "string", "example": "hi" },
          "dailyHoroscopeEnabled": { "type": "boolean", "example": true },
          "panchangEnabled": { "type": "boolean", "example": true },
          "festivalAlertsEnabled": { "type": "boolean", "example": true },
          "preferredZodiacSign": { "type": "string", "example": "ARIES" }
        }
      },
      "NotificationPreferences": {
        "type": "object",
        "properties": {
          "pushEnabled": { "type": "boolean", "example": true },
          "whatsappEnabled": { "type": "boolean", "example": false },
          "smsEnabled": { "type": "boolean", "example": true },
          "emailEnabled": { "type": "boolean", "example": true },
          "marketingNotificationsEnabled": { "type": "boolean", "example": false },
          "dailyHoroscopeEnabled": { "type": "boolean", "example": true },
          "festivalAlertsEnabled": { "type": "boolean", "example": true }
        }
      },
      "SecurityOverview": {
        "type": "object",
        "properties": {
          "accountStatus": { "type": "string", "example": "ACTIVE" },
          "mobileNumber": { "type": "string", "example": "+919876543210" },
          "mobileVerified": { "type": "boolean", "example": true },
          "email": { "type": "string", "nullable": true, "example": "user@example.com" },
          "emailVerified": { "type": "boolean", "example": false },
          "activeSessionsCount": { "type": "integer", "example": 2 },
          "activeDevicesCount": { "type": "integer", "example": 2 },
          "currentSessionId": { "type": "string", "format": "uuid" },
          "lastLoginAt": { "type": "string", "format": "date-time" }
        }
      }
    }
  },
  "paths": {
    "/api/v1/auth/send-otp": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Send OTP for Login / Registration",
        "description": "Sends a 4-digit OTP. If customer exists, prepares login; if new, prepares registration.",
        "responses": { "200": { "description": "OTP sent successfully" } }
      }
    },
    "/api/v1/auth/verify-otp": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Verify OTP (Atomic Login / Registration)",
        "description": "Verifies 4-digit OTP, creates customer if new, assigns CUSTOMER role, issues JWT and refresh tokens.",
        "responses": { "200": { "description": "Login successful" } }
      }
    },
    "/api/v1/auth/refresh-token": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Refresh Access Token",
        "description": "Rotates refresh token and returns new JWT access token.",
        "responses": { "200": { "description": "Token refreshed successfully" } }
      }
    },
    "/api/v1/customers/me": {
      "get": {
        "tags": ["Customer Profile"],
        "summary": "3.1 Get Profile (with Wallet info)",
        "security": [{ "BearerAuth": [] }],
        "description": "Retrieves the authenticated customer's full profile including wallet balance, verification flags, and profile completion percentage.",
        "responses": {
          "200": {
            "description": "Profile retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/ApiResponse" },
                    { "properties": { "data": { "$ref": "#/components/schemas/CustomerProfile" } } }
                  ]
                }
              }
            }
          },
          "401": { "description": "Unauthorized" }
        }
      },
      "patch": {
        "tags": ["Customer Profile"],
        "summary": "3.2 Update Profile",
        "security": [{ "BearerAuth": [] }],
        "description": "Updates allowlisted fields (fullName, email, dateOfBirth, gender, preferredLanguage). Changing email resets email verification status.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateCustomerProfileRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "Profile updated successfully" },
          "400": { "description": "Validation error" },
          "409": { "description": "Email already in use" }
        }
      }
    },
    "/api/v1/customers/me/status": {
      "get": {
        "tags": ["Customer Profile"],
        "summary": "3.3 Get Status and Profile Completion",
        "security": [{ "BearerAuth": [] }],
        "description": "Returns account status, completion percentage, missing fields, astrology service eligibility, and wallet info.",
        "responses": {
          "200": {
            "description": "Status retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/ApiResponse" },
                    { "properties": { "data": { "$ref": "#/components/schemas/ProfileStatus" } } }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/customers/me/profile-photo": {
      "post": {
        "tags": ["Customer Profile"],
        "summary": "3.4 Upload Profile Photo",
        "security": [{ "BearerAuth": [] }],
        "description": "Sets or updates customer profile photo.",
        "responses": { "200": { "description": "Profile photo updated successfully" } }
      },
      "delete": {
        "tags": ["Customer Profile"],
        "summary": "3.4 Remove Profile Photo",
        "security": [{ "BearerAuth": [] }],
        "description": "Removes customer profile photo.",
        "responses": { "200": { "description": "Profile photo removed successfully" } }
      }
    },
    "/api/v1/customers/me/birth-profiles": {
      "get": {
        "tags": ["Birth Profiles"],
        "summary": "4.1 List Birth Profiles",
        "security": [{ "BearerAuth": [] }],
        "description": "Lists all saved birth profiles for customer and family members.",
        "responses": {
          "200": {
            "description": "Birth profiles retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/ApiResponse" },
                    {
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": { "$ref": "#/components/schemas/BirthProfile" }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Birth Profiles"],
        "summary": "4.2 Create Birth Profile",
        "security": [{ "BearerAuth": [] }],
        "description": "Creates a new birth profile with birth place coordinates, timezone, and relationship.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateBirthProfileRequest" }
            }
          }
        },
        "responses": {
          "201": { "description": "Birth profile created successfully" },
          "400": { "description": "Validation error" }
        }
      }
    },
    "/api/v1/customers/me/birth-profiles/{profileId}": {
      "get": {
        "tags": ["Birth Profiles"],
        "summary": "4.3 Get Birth Profile",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "name": "profileId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Birth profile retrieved" }, "404": { "description": "Not found" } }
      },
      "put": {
        "tags": ["Birth Profiles"],
        "summary": "4.4 Update Birth Profile",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "name": "profileId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateBirthProfileRequest" } } }
        },
        "responses": { "200": { "description": "Birth profile updated" } }
      },
      "delete": {
        "tags": ["Birth Profiles"],
        "summary": "4.5 Delete Birth Profile",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "name": "profileId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Birth profile deleted" } }
      }
    },
    "/api/v1/customers/me/birth-profiles/{profileId}/default": {
      "patch": {
        "tags": ["Birth Profiles"],
        "summary": "4.6 Set Default Birth Profile",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "name": "profileId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Default birth profile updated atomically" } }
      }
    },
    "/api/v1/customers/me/preferences": {
      "get": {
        "tags": ["Preferences"],
        "summary": "6.1 Get Customer Preferences",
        "security": [{ "BearerAuth": [] }],
        "responses": { "200": { "description": "Preferences retrieved successfully" } }
      },
      "put": {
        "tags": ["Preferences"],
        "summary": "6.2 Update Customer Preferences",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CustomerPreferences" } } }
        },
        "responses": { "200": { "description": "Preferences updated successfully" } }
      }
    },
    "/api/v1/customers/me/notification-preferences": {
      "get": {
        "tags": ["Preferences"],
        "summary": "6.3 Get Notification Preferences",
        "security": [{ "BearerAuth": [] }],
        "responses": { "200": { "description": "Notification preferences retrieved successfully" } }
      },
      "put": {
        "tags": ["Preferences"],
        "summary": "6.3 Update Notification Preferences",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NotificationPreferences" } } }
        },
        "responses": { "200": { "description": "Notification preferences updated successfully" } }
      }
    },
    "/api/v1/customers/me/sessions": {
      "get": {
        "tags": ["Sessions & Devices"],
        "summary": "7.1 List Active Sessions",
        "security": [{ "BearerAuth": [] }],
        "responses": { "200": { "description": "Sessions retrieved successfully" } }
      }
    },
    "/api/v1/customers/me/sessions/{sessionId}": {
      "delete": {
        "tags": ["Sessions & Devices"],
        "summary": "7.2 Revoke One Session",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "name": "sessionId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Session revoked successfully" } }
      }
    },
    "/api/v1/customers/me/sessions/revoke-all": {
      "post": {
        "tags": ["Sessions & Devices"],
        "summary": "7.3 Revoke All Other Sessions",
        "security": [{ "BearerAuth": [] }],
        "description": "Revokes all other sessions while keeping the current device session active.",
        "responses": { "200": { "description": "Other sessions revoked successfully" } }
      }
    },
    "/api/v1/customers/me/devices": {
      "get": {
        "tags": ["Sessions & Devices"],
        "summary": "7.4 List Devices",
        "security": [{ "BearerAuth": [] }],
        "responses": { "200": { "description": "Devices retrieved successfully" } }
      }
    },
    "/api/v1/customers/me/security": {
      "get": {
        "tags": ["Security"],
        "summary": "8.1 Security Overview",
        "security": [{ "BearerAuth": [] }],
        "responses": { "200": { "description": "Security overview retrieved successfully" } }
      }
    },
    "/api/v1/customers/me/security/logout": {
      "post": {
        "tags": ["Security"],
        "summary": "8.2 Logout Current Session",
        "security": [{ "BearerAuth": [] }],
        "responses": { "200": { "description": "Logged out successfully" } }
      }
    },
    "/api/v1/customers/me/security/logout-all": {
      "post": {
        "tags": ["Security"],
        "summary": "8.3 Logout All Devices",
        "security": [{ "BearerAuth": [] }],
        "responses": { "200": { "description": "All devices logged out successfully" } }
      }
    }
  }
}
