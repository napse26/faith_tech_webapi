{
  "openapi": "3.0.3",
  "info": {
    "title": "DharmaDarshan - OTP Authentication & Identity Management API",
    "version": "1.0.0",
    "description": "Production-ready, developer-ready REST API for DharmaDarshan mobile OTP authentication, multi-device session management, token lifecycle, customer registration, and profile management. Powered by Node.js, Express, Prisma, and PostgreSQL (Supabase)."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local Development Server"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ApiResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "message": { "type": "string" },
          "data": { "type": "object", "nullable": true },
          "error": {
            "type": "object",
            "properties": {
              "code": { "type": "string" },
              "details": { "nullable": true }
            }
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": { "type": "string" },
                "field": { "type": "string" },
                "message": { "type": "string" }
              }
            }
          },
          "traceId": { "type": "string" }
        }
      },
      "SendOtpRequest": {
        "type": "object",
        "required": ["phoneNumber"],
        "properties": {
          "phoneNumber": { "type": "string", "example": "+919876543210" },
          "countryCode": { "type": "string", "example": "+91", "default": "+91" },
          "purpose": { "type": "string", "enum": ["LOGIN", "REGISTER", "CHANGE_PHONE", "ACCOUNT_RECOVERY"], "default": "LOGIN" },
          "channel": { "type": "string", "enum": ["SMS", "WHATSAPP"], "default": "SMS" }
        }
      },
      "SendOtpResponse": {
        "type": "object",
        "properties": {
          "challengeId": { "type": "string", "format": "uuid" },
          "maskedPhoneNumber": { "type": "string", "example": "+91******3210" },
          "otpLength": { "type": "integer", "example": 4 },
          "expiresIn": { "type": "integer", "example": 300 },
          "resendAfter": { "type": "integer", "example": 90 },
          "sampleOtp": { "type": "string", "example": "1234" }
        }
      },
      "VerifyOtpRequest": {
        "type": "object",
        "required": ["challengeId", "otp"],
        "properties": {
          "challengeId": { "type": "string", "format": "uuid" },
          "otp": { "type": "string", "example": "1234" },
          "device": {
            "type": "object",
            "properties": {
              "deviceId": { "type": "string", "example": "device-123" },
              "deviceName": { "type": "string", "example": "Samsung Galaxy S22" },
              "platform": { "type": "string", "enum": ["ANDROID", "IOS", "WEB"], "example": "ANDROID" },
              "appVersion": { "type": "string", "example": "1.0.0" }
            }
          }
        }
      },
      "VerifyOtpResponse": {
        "type": "object",
        "properties": {
          "isNewUser": { "type": "boolean", "example": true },
          "isProfileComplete": { "type": "boolean", "example": false },
          "accessToken": { "type": "string", "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..." },
          "refreshToken": { "type": "string", "example": "b188c634c062c3e41b2c4e..." },
          "tokenType": { "type": "string", "example": "Bearer" },
          "expiresIn": { "type": "integer", "example": 900 },
          "user": {
            "type": "object",
            "properties": {
              "customerId": { "type": "integer", "example": 101 },
              "name": { "type": "string", "nullable": true, "example": null },
              "phoneNumber": { "type": "string", "example": "+919876543210" },
              "email": { "type": "string", "nullable": true, "example": null },
              "role": { "type": "string", "example": "CUSTOMER" },
              "status": { "type": "string", "example": "ACTIVE" },
              "isMobileVerified": { "type": "boolean", "example": true }
            }
          }
        }
      },
      "ResendOtpRequest": {
        "type": "object",
        "required": ["challengeId"],
        "properties": {
          "challengeId": { "type": "string", "format": "uuid" }
        }
      },
      "RefreshTokenRequest": {
        "type": "object",
        "required": ["refreshToken"],
        "properties": {
          "refreshToken": { "type": "string", "example": "b188c634c062c3e41b2c4e..." }
        }
      },
      "RefreshTokenResponse": {
        "type": "object",
        "properties": {
          "accessToken": { "type": "string" },
          "refreshToken": { "type": "string" },
          "tokenType": { "type": "string", "example": "Bearer" },
          "expiresIn": { "type": "integer", "example": 900 }
        }
      },
      "UserSessionDto": {
        "type": "object",
        "properties": {
          "sessionId": { "type": "string", "format": "uuid" },
          "deviceId": { "type": "string", "nullable": true },
          "deviceType": { "type": "string", "nullable": true },
          "deviceName": { "type": "string", "nullable": true },
          "ipAddress": { "type": "string", "nullable": true },
          "lastActiveAt": { "type": "string", "format": "date-time" },
          "createdAt": { "type": "string", "format": "date-time" },
          "isCurrent": { "type": "boolean" }
        }
      },
      "ChangeMobileSendOtpRequest": {
        "type": "object",
        "required": ["newPhoneNumber"],
        "properties": {
          "newPhoneNumber": { "type": "string", "example": "+919876543211" },
          "countryCode": { "type": "string", "example": "+91", "default": "+91" }
        }
      },
      "ChangeMobileVerifyOtpRequest": {
        "type": "object",
        "required": ["challengeId", "otp"],
        "properties": {
          "challengeId": { "type": "string", "format": "uuid" },
          "otp": { "type": "string", "example": "1234" }
        }
      }
    }
  },
  "paths": {
    "/api/v1/auth/send-otp": {
      "post": {
        "tags": ["Authentication"],
        "summary": "7.1 Send OTP (Login / Registration)",
        "description": "Dispatches a 4-digit OTP challenge to the provided phone number. If customer exists, initiates login; if not, prepares automatic new customer registration. In dev mode, includes sampleOtp: '1234'.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SendOtpRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OTP sent successfully",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/ApiResponse" },
                    { "properties": { "data": { "$ref": "#/components/schemas/SendOtpResponse" } } }
                  ]
                }
              }
            }
          },
          "400": { "description": "Invalid phone number format (INVALID_PHONE_NUMBER)" },
          "429": { "description": "Rate limit exceeded (RATE_LIMIT_EXCEEDED)" }
        }
      }
    },
    "/api/v1/auth/verify-otp": {
      "post": {
        "tags": ["Authentication"],
        "summary": "7.2 Verify OTP (Atomic Login / Registration)",
        "description": "Verifies 4-digit OTP. If customer already exists, checks account status (ACTIVE/BLOCKED/SUSPENDED) and logs in (`isNewUser: false`). If customer does not exist, registers new customer, creates `customer_details`, assigns `CUSTOMER` role, and issues tokens (`isNewUser: true`).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/VerifyOtpRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login/Registration successful",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/ApiResponse" },
                    { "properties": { "data": { "$ref": "#/components/schemas/VerifyOtpResponse" } } }
                  ]
                }
              }
            }
          },
          "400": { "description": "Invalid OTP (INVALID_OTP) or Expired OTP (OTP_EXPIRED)" },
          "403": { "description": "Account suspended or blocked (ACCOUNT_BLOCKED / ACCOUNT_SUSPENDED)" },
          "404": { "description": "Challenge not found (INVALID_CHALLENGE)" },
          "409": { "description": "OTP already used (OTP_ALREADY_USED)" },
          "429": { "description": "Max attempts exceeded (OTP_ATTEMPTS_EXCEEDED)" }
        }
      }
    },
    "/api/v1/auth/resend-otp": {
      "post": {
        "tags": ["Authentication"],
        "summary": "7.3 Resend OTP",
        "description": "Generates a replacement OTP challenge after verifying the 90-second resend cooldown has elapsed. Invalidates the previous OTP.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ResendOtpRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OTP resent successfully",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/ApiResponse" },
                    { "properties": { "data": { "$ref": "#/components/schemas/SendOtpResponse" } } }
                  ]
                }
              }
            }
          },
          "429": { "description": "Resend cooldown active (RESEND_COOLDOWN_ACTIVE)" }
        }
      }
    },
    "/api/v1/auth/refresh-token": {
      "post": {
        "tags": ["Authentication"],
        "summary": "7.4 Refresh Access Token",
        "description": "Exchanges an opaque refresh token for a new access token and rotated refresh token. Detects token reuse and immediately revokes all sessions if reuse occurs.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RefreshTokenRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token refreshed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/ApiResponse" },
                    { "properties": { "data": { "$ref": "#/components/schemas/RefreshTokenResponse" } } }
                  ]
                }
              }
            }
          },
          "401": { "description": "Invalid refresh token or token reuse detected (TOKEN_REUSE_DETECTED / INVALID_REFRESH_TOKEN)" }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": ["Authentication"],
        "summary": "7.5 Logout",
        "security": [{ "BearerAuth": [] }],
        "description": "Revokes current device session in user_sessions and invalidates associated refresh token.",
        "responses": {
          "200": { "description": "Logged out successfully" },
          "401": { "description": "Unauthorized / Session revoked" }
        }
      }
    },
    "/api/v1/auth/logout-all": {
      "post": {
        "tags": ["Authentication"],
        "summary": "7.6 Logout All Devices",
        "security": [{ "BearerAuth": [] }],
        "description": "Revokes all active sessions for the authenticated customer across all devices.",
        "responses": {
          "200": { "description": "All devices logged out successfully" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "tags": ["Authentication"],
        "summary": "7.7 Get Current User",
        "security": [{ "BearerAuth": [] }],
        "description": "Returns current customer profile, verification status, and role.",
        "responses": {
          "200": { "description": "Customer profile retrieved successfully" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/api/v1/auth/sessions": {
      "get": {
        "tags": ["Authentication"],
        "summary": "7.8 Active Sessions",
        "security": [{ "BearerAuth": [] }],
        "description": "Lists all active device sessions for current customer.",
        "responses": {
          "200": {
            "description": "Active sessions retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/ApiResponse" },
                    {
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": { "$ref": "#/components/schemas/UserSessionDto" }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/api/v1/auth/sessions/{sessionId}": {
      "delete": {
        "tags": ["Authentication"],
        "summary": "7.9 Revoke Selected Session",
        "security": [{ "BearerAuth": [] }],
        "description": "Revokes the specified session after verifying it belongs to the authenticated customer.",
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": { "description": "Session revoked successfully" },
          "403": { "description": "Cannot revoke session belonging to another user" },
          "404": { "description": "Session not found" }
        }
      }
    },
    "/api/v1/auth/change-mobile/send-otp": {
      "post": {
        "tags": ["Authentication"],
        "summary": "7.10 Mobile Number Change - Step 1: Send OTP",
        "security": [{ "BearerAuth": [] }],
        "description": "Sends verification OTP to the new mobile number after ensuring it is not registered to another customer.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ChangeMobileSendOtpRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "OTP sent to new mobile number" },
          "409": { "description": "Mobile number already registered to another account (PHONE_NUMBER_IN_USE)" }
        }
      }
    },
    "/api/v1/auth/change-mobile/verify-otp": {
      "post": {
        "tags": ["Authentication"],
        "summary": "7.10 Mobile Number Change - Step 2: Verify OTP",
        "security": [{ "BearerAuth": [] }],
        "description": "Verifies OTP and transactionally updates customer registered mobile number.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ChangeMobileVerifyOtpRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "Mobile number updated successfully" },
          "400": { "description": "Invalid OTP (INVALID_OTP)" },
          "409": { "description": "Phone number conflict" }
        }
      }
    }
  }
}
