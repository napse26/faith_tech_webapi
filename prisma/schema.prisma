generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model admin_details {
  admin_detail_id BigInt    @id @default(autoincrement())
  user_id         BigInt    @unique
  employee_code   String?   @db.VarChar(50)
  first_name      String?   @db.VarChar(100)
  last_name       String?   @db.VarChar(100)
  designation     String?   @db.VarChar(100)
  department      String?   @db.VarChar(100)
  profile_image   String?   @db.VarChar(500)
  is_super_admin  Boolean?  @default(false)
  created_on      DateTime? @default(now()) @db.Timestamptz(6)
  updated_on      DateTime? @default(now()) @db.Timestamptz(6)
  users           users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
}

model appointments {
  appointment_id   BigInt      @id @default(autoincrement())
  user_id          BigInt
  astrologer_id    BigInt
  appointment_date DateTime    @db.Timestamptz(6)
  status           String      @db.VarChar(20)
  remarks          String?     @db.VarChar(500)
  created_on       DateTime?   @default(now()) @db.Timestamptz(6)
  astrologers      astrologers @relation(fields: [astrologer_id], references: [astrologer_id], onDelete: Cascade, onUpdate: NoAction)
  users            users       @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
}

model astrologer_kyc {
  astrologer_kyc_id   BigInt      @id @default(autoincrement())
  astrologer_id       BigInt
  pan_number          String?     @db.VarChar(20)
  aadhaar_number      String?     @db.VarChar(20)
  account_holder_name String?     @db.VarChar(200)
  account_number      String?     @db.VarChar(50)
  bank_name           String?     @db.VarChar(200)
  ifsc_code           String?     @db.VarChar(20)
  verification_status String?     @default("PENDING") @db.VarChar(20)
  approved_by         BigInt?
  approved_on         DateTime?   @db.Timestamptz(6)
  created_on          DateTime?   @default(now()) @db.Timestamptz(6)
  users               users?      @relation(fields: [approved_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  astrologers         astrologers @relation(fields: [astrologer_id], references: [astrologer_id], onDelete: Cascade, onUpdate: NoAction)
}

model astrologer_languages {
  astrologer_language_id BigInt      @id @default(autoincrement())
  astrologer_id          BigInt
  language_id            Int
  astrologers            astrologers @relation(fields: [astrologer_id], references: [astrologer_id], onDelete: Cascade, onUpdate: NoAction)
  languages              languages   @relation(fields: [language_id], references: [language_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([astrologer_id, language_id], map: "uq_astrologer_languages")
}

model astrologer_service_request_checklist {
  astrologer_service_request_checklist_id Int                               @id @default(autoincrement())
  astrologer_service_request_master_id    Int
  service_master_id                       Int
  service_checklist_master_id             Int
  dms_items_id                            Int?
  created_on                              DateTime?                         @default(now()) @db.Timestamptz(6)
  astrologer_service_request_master       astrologer_service_request_master @relation(fields: [astrologer_service_request_master_id], references: [astrologer_service_request_master_id], onDelete: Cascade, onUpdate: NoAction, map: "astrologer_service_request_ch_astrologer_service_request_m_fkey")
  service_checklist_master                service_checklist_master          @relation(fields: [service_checklist_master_id], references: [service_checklist_master_id], onDelete: NoAction, onUpdate: NoAction, map: "astrologer_service_request_che_service_checklist_master_id_fkey")
  tbl_dms_items                           tbl_dms_items?                    @relation(fields: [dms_items_id], references: [dms_items_id], onDelete: NoAction, onUpdate: NoAction)
  service_master                          service_master                    @relation(fields: [service_master_id], references: [service_master_id], onDelete: NoAction, onUpdate: NoAction)
}

model astrologer_service_request_master {
  astrologer_service_request_master_id Int                                    @id @default(autoincrement())
  service_master_id                    Int
  request_status                       String?                                @default("PENDING") @db.VarChar(20)
  created_by                           BigInt?
  created_on                           DateTime?                              @default(now()) @db.Timestamptz(6)
  astrologer_service_request_checklist astrologer_service_request_checklist[]
  users                                users?                                 @relation(fields: [created_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  service_master                       service_master                         @relation(fields: [service_master_id], references: [service_master_id], onDelete: NoAction, onUpdate: NoAction)
  astrologer_services                  astrologer_services[]
}

model astrologer_services {
  astrologer_service_id                Int                                @id @default(autoincrement())
  astrologer_service_request_master_id Int?
  service_master_id                    Int
  astrologer_id                        BigInt
  status                               Int?                               @default(1) @db.SmallInt
  is_kyc_completed                     Int?                               @default(0) @db.SmallInt
  created_by                           BigInt?
  created_on                           DateTime?                          @default(now()) @db.Timestamptz(6)
  astrologers                          astrologers                        @relation(fields: [astrologer_id], references: [astrologer_id], onDelete: Cascade, onUpdate: NoAction)
  astrologer_service_request_master    astrologer_service_request_master? @relation(fields: [astrologer_service_request_master_id], references: [astrologer_service_request_master_id], onDelete: NoAction, onUpdate: NoAction)
  users                                users?                             @relation(fields: [created_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  service_master                       service_master                     @relation(fields: [service_master_id], references: [service_master_id], onDelete: NoAction, onUpdate: NoAction)
}

model astrologer_specializations {
  astrologer_specialization_id BigInt          @id @default(autoincrement())
  astrologer_id                BigInt
  specialization_id            Int
  astrologers                  astrologers     @relation(fields: [astrologer_id], references: [astrologer_id], onDelete: Cascade, onUpdate: NoAction)
  specializations              specializations @relation(fields: [specialization_id], references: [specialization_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([astrologer_id, specialization_id], map: "uq_astrologer_specializations")
}

model astrologers {
  astrologer_id                     BigInt                              @id @default(autoincrement())
  user_id                           BigInt                              @unique
  display_name                      String                              @db.VarChar(200)
  gender                            String?                             @db.VarChar(10)
  experience_years                  Int?                                @default(0)
  qualification                     String?                             @db.VarChar(500)
  about_me                          String?
  profile_image                     String?                             @db.VarChar(500)
  cover_image                       String?                             @db.VarChar(500)
  chat_rate                         Decimal?                            @default(0) @db.Decimal(10, 2)
  call_rate                         Decimal?                            @default(0) @db.Decimal(10, 2)
  video_rate                        Decimal?                            @default(0) @db.Decimal(10, 2)
  commission_percentage             Decimal?                            @default(0) @db.Decimal(5, 2)
  avg_rating                        Decimal?                            @default(0) @db.Decimal(3, 2)
  total_reviews                     Int?                                @default(0)
  total_chat_minutes                Int?                                @default(0)
  total_call_minutes                Int?                                @default(0)
  total_video_minutes               Int?                                @default(0)
  total_earnings                    Decimal?                            @default(0) @db.Decimal(18, 2)
  is_online                         Boolean?                            @default(false)
  is_busy                           Boolean?                            @default(false)
  is_verified                       Boolean?                            @default(false)
  verification_date                 DateTime?                           @db.Timestamptz(6)
  created_on                        DateTime?                           @default(now()) @db.Timestamptz(6)
  updated_on                        DateTime?                           @default(now()) @db.Timestamptz(6)
  appointments                      appointments[]
  astrologer_kyc                    astrologer_kyc[]
  astrologer_languages              astrologer_languages[]
  astrologer_services               astrologer_services[]
  astrologer_specializations        astrologer_specializations[]
  users                             users                               @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  broadcasts                        broadcasts[]
  favorite_astrologers              favorite_astrologers[]
  reviews                           reviews[]
  user_consultation_sessions_detail user_consultation_sessions_detail[]
}

model auth_audit_logs {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        BigInt?
  phone_number   String?  @db.VarChar(20)
  event_type     String   @db.VarChar(50)
  ip_address     String?  @db.VarChar(45)
  device_id      String?  @db.VarChar(255)
  status         String   @db.VarChar(20)
  failure_reason String?  @db.VarChar(100)
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  users          users?   @relation(fields: [user_id], references: [user_id], onUpdate: NoAction)

  @@index([event_type, created_at(sort: Desc)], map: "idx_audit_event_time")
  @@index([phone_number], map: "idx_audit_phone")
  @@index([user_id], map: "idx_audit_user_id")
}

model broadcast_participants {
  broadcast_participant_id BigInt     @id @default(autoincrement())
  broadcast_id             BigInt
  user_id                  BigInt
  joined_on                DateTime?  @default(now()) @db.Timestamptz(6)
  broadcasts               broadcasts @relation(fields: [broadcast_id], references: [broadcast_id], onDelete: Cascade, onUpdate: NoAction)
  users                    users      @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
}

model broadcasts {
  broadcast_id           BigInt                   @id @default(autoincrement())
  astrologer_id          BigInt
  title                  String                   @db.VarChar(500)
  description            String?
  rtc_channel_id         String?                  @db.VarChar(200)
  start_time             DateTime?                @db.Timestamptz(6)
  end_time               DateTime?                @db.Timestamptz(6)
  status                 String?                  @db.VarChar(20)
  created_on             DateTime?                @default(now()) @db.Timestamptz(6)
  broadcast_participants broadcast_participants[]
  astrologers            astrologers              @relation(fields: [astrologer_id], references: [astrologer_id], onDelete: Cascade, onUpdate: NoAction)
}

model consultations {
  consultation_id                   BigInt                              @id @default(autoincrement())
  consultation_type                 String                              @db.VarChar(50)
  created_on                        DateTime?                           @default(now()) @db.Timestamptz(6)
  user_consultation_sessions_detail user_consultation_sessions_detail[]
}

model coupons {
  coupon_id      BigInt    @id @default(autoincrement())
  coupon_code    String    @unique @db.VarChar(100)
  discount_type  String    @db.VarChar(10)
  discount_value Decimal   @db.Decimal(10, 2)
  expiry_date    DateTime? @db.Timestamptz(6)
  is_active      Boolean?  @default(true)
}

model customer_details {
  customer_profile_id                       BigInt    @id @default(autoincrement())
  user_id                                   BigInt    @unique
  first_name                                String?   @db.VarChar(100)
  last_name                                 String?   @db.VarChar(100)
  gender                                    String?   @db.VarChar(10)
  date_of_birth                             DateTime? @db.Date
  time_of_birth                             DateTime? @db.Time(6)
  place_of_birth                            String?   @db.VarChar(200)
  marital_status                            String?   @db.VarChar(20)
  occupation                                String?   @db.VarChar(200)
  profile_image                             String?   @db.VarChar(500)
  preferred_language                        String?   @db.VarChar(50)
  referral_code                             String?   @db.VarChar(50)
  referred_by                               BigInt?
  total_recharge                            Decimal?  @default(0) @db.Decimal(18, 2)
  total_spent                               Decimal?  @default(0) @db.Decimal(18, 2)
  created_on                                DateTime? @default(now()) @db.Timestamptz(6)
  updated_on                                DateTime? @default(now()) @db.Timestamptz(6)
  users_customer_details_referred_byTousers users?    @relation("customer_details_referred_byTousers", fields: [referred_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  users_customer_details_user_idTousers     users     @relation("customer_details_user_idTousers", fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
}

model document_master {
  document_master_id       Int                        @id @default(autoincrement())
  document_name            String                     @db.VarChar(100)
  status                   Int?                       @default(1) @db.SmallInt
  created_by               BigInt?
  created_on               DateTime?                  @default(now()) @db.Timestamptz(6)
  users                    users?                     @relation(fields: [created_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  service_checklist_master service_checklist_master[]
}

model favorite_astrologers {
  favorite_id   BigInt      @id @default(autoincrement())
  user_id       BigInt
  astrologer_id BigInt
  created_on    DateTime?   @default(now()) @db.Timestamptz(6)
  astrologers   astrologers @relation(fields: [astrologer_id], references: [astrologer_id], onDelete: Cascade, onUpdate: NoAction)
  users         users       @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, astrologer_id], map: "uq_favorite_astrologers")
}

model kundli_profiles {
  kundli_profile_id BigInt    @id @default(autoincrement())
  user_id           BigInt
  person_name       String    @db.VarChar(200)
  gender            String?   @db.VarChar(10)
  date_of_birth     DateTime? @db.Date
  time_of_birth     DateTime? @db.Time(6)
  place_of_birth    String?   @db.VarChar(200)
  latitude          Decimal?  @db.Decimal(12, 8)
  longitude         Decimal?  @db.Decimal(12, 8)
  created_on        DateTime? @default(now()) @db.Timestamptz(6)
  users             users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
}

model languages {
  language_id          Int                    @id @default(autoincrement())
  language_name        String                 @unique @db.VarChar(100)
  astrologer_languages astrologer_languages[]
}

model otp_verification {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  challenge_id String    @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone_number String    @db.VarChar(20)
  purpose      String    @db.VarChar(30)
  channel      String    @default("SMS") @db.VarChar(20)
  otp_hash     String    @db.VarChar(128)
  status       String    @default("PENDING") @db.VarChar(20)
  attempts     Int       @default(0)
  resend_count Int       @default(0)
  expires_at   DateTime  @db.Timestamptz(6)
  verified_at  DateTime? @db.Timestamptz(6)
  consumed_at  DateTime? @db.Timestamptz(6)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  updated_at   DateTime  @default(now()) @db.Timestamptz(6)

  @@index([challenge_id], map: "idx_otp_challenge")
  @@index([phone_number, created_at(sort: Desc)], map: "idx_otp_phone_created")
  @@index([status], map: "idx_otp_status")
}

model payment_transactions {
  payment_transaction_id BigInt    @id @default(autoincrement())
  user_id                BigInt
  gateway_order_id       String?   @db.VarChar(200)
  gateway_payment_id     String?   @db.VarChar(200)
  amount                 Decimal   @db.Decimal(18, 2)
  payment_status         String    @db.VarChar(20)
  payment_method         String?   @db.VarChar(50)
  created_on             DateTime? @default(now()) @db.Timestamptz(6)
  users                  users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
}

model referrals {
  referral_id                             BigInt    @id @default(autoincrement())
  referrer_user_id                        BigInt
  referred_user_id                        BigInt    @unique(map: "uq_referrals")
  referral_bonus                          Decimal?  @default(0) @db.Decimal(18, 2)
  created_on                              DateTime? @default(now()) @db.Timestamptz(6)
  users_referrals_referred_user_idTousers users     @relation("referrals_referred_user_idTousers", fields: [referred_user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  users_referrals_referrer_user_idTousers users     @relation("referrals_referrer_user_idTousers", fields: [referrer_user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model reviews {
  review_id     BigInt      @id @default(autoincrement())
  user_id       BigInt
  astrologer_id BigInt
  rating        Decimal     @db.Decimal(2, 1)
  review_text   String?
  created_on    DateTime?   @default(now()) @db.Timestamptz(6)
  astrologers   astrologers @relation(fields: [astrologer_id], references: [astrologer_id], onDelete: Cascade, onUpdate: NoAction)
  users         users       @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
}

model role_permissions {
  role_permission_id BigInt           @id @default(autoincrement())
  role_id            Int              @db.SmallInt
  permission_id      BigInt
  user_permissions   user_permissions @relation(fields: [permission_id], references: [permission_id], onDelete: Cascade, onUpdate: NoAction)
  roles              roles            @relation(fields: [role_id], references: [role_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([role_id, permission_id], map: "uq_role_permissions")
}

model roles {
  role_id          Int                @id @default(autoincrement()) @db.SmallInt
  role_name        String             @unique @db.VarChar(50)
  role_permissions role_permissions[]
  user_roles       user_roles[]
}

model service_checklist_master {
  service_checklist_master_id          Int                                    @id @default(autoincrement())
  checklist_name                       String                                 @db.VarChar(100)
  is_document_required                 Int?                                   @default(0) @db.SmallInt
  document_master_id                   Int?
  status                               Int?                                   @default(1) @db.SmallInt
  created_by                           BigInt?
  created_on                           DateTime?                              @default(now()) @db.Timestamptz(6)
  astrologer_service_request_checklist astrologer_service_request_checklist[]
  users                                users?                                 @relation(fields: [created_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  document_master                      document_master?                       @relation(fields: [document_master_id], references: [document_master_id], onDelete: NoAction, onUpdate: NoAction)
  services_checklist_mapping_master    services_checklist_mapping_master[]
}

model service_master {
  service_master_id                    Int                                    @id @default(autoincrement())
  service_name                         String                                 @db.VarChar(100)
  status                               Int?                                   @default(1) @db.SmallInt
  created_by                           BigInt?
  created_on                           DateTime?                              @default(now()) @db.Timestamptz(6)
  astrologer_service_request_checklist astrologer_service_request_checklist[]
  astrologer_service_request_master    astrologer_service_request_master[]
  astrologer_services                  astrologer_services[]
  users                                users?                                 @relation(fields: [created_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  services_checklist_mapping_master    services_checklist_mapping_master[]
}

model services_checklist_mapping_master {
  services_checklist_mapping_master_id Int                      @id @default(autoincrement())
  service_master_id                    Int
  service_checklist_master_id          Int
  status                               Int?                     @default(1) @db.SmallInt
  created_by                           BigInt?
  created_on                           DateTime?                @default(now()) @db.Timestamptz(6)
  service_checklist_master             service_checklist_master @relation(fields: [service_checklist_master_id], references: [service_checklist_master_id], onDelete: NoAction, onUpdate: NoAction, map: "services_checklist_mapping_mas_service_checklist_master_id_fkey")
  users                                users?                   @relation(fields: [created_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  service_master                       service_master           @relation(fields: [service_master_id], references: [service_master_id], onDelete: NoAction, onUpdate: NoAction)
}

model specializations {
  specialization_id          Int                          @id @default(autoincrement())
  specialization_name        String                       @unique @db.VarChar(100)
  astrologer_specializations astrologer_specializations[]
}

model tbl_dms_basepath {
  dms_basepath_id Int             @id @default(autoincrement())
  dms_base_path   String          @db.VarChar(1000)
  folder_name     String?         @db.VarChar(500)
  application     String?         @db.VarChar(100)
  active          Int?            @default(1) @db.SmallInt
  created_on      DateTime?       @default(now()) @db.Timestamptz(6)
  tbl_dms_items   tbl_dms_items[]
}

model tbl_dms_category {
  dms_category_id Int             @id @default(autoincrement())
  category        String          @db.VarChar(100)
  category_code   String?         @db.VarChar(100)
  folder_name     String?         @db.VarChar(500)
  module          String?         @db.VarChar(100)
  is_generic      Int?            @default(0) @db.SmallInt
  active          Int?            @default(1) @db.SmallInt
  created_by      BigInt?
  created_on      DateTime?       @default(now()) @db.Timestamptz(6)
  users           users?          @relation(fields: [created_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  tbl_dms_items   tbl_dms_items[]
}

model tbl_dms_items {
  dms_items_id                         Int                                    @id @default(autoincrement())
  year                                 String?                                @db.VarChar(6)
  month                                Int?
  category_id                          Int?
  basepath_id                          Int?
  active                               Int?                                   @default(1) @db.SmallInt
  file_path                            String                                 @db.VarChar(500)
  remarks                              String?                                @db.VarChar(250)
  location                             String?                                @db.VarChar(250)
  filename                             String                                 @db.VarChar(500)
  created_by                           BigInt?
  created_on                           DateTime?                              @default(now()) @db.Timestamptz(6)
  astrologer_service_request_checklist astrologer_service_request_checklist[]
  tbl_dms_basepath                     tbl_dms_basepath?                      @relation(fields: [basepath_id], references: [dms_basepath_id], onDelete: NoAction, onUpdate: NoAction)
  tbl_dms_category                     tbl_dms_category?                      @relation(fields: [category_id], references: [dms_category_id], onDelete: NoAction, onUpdate: NoAction)
  users                                users?                                 @relation(fields: [created_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
}

model user_consultation_sessions_detail {
  session_id      BigInt        @id @default(autoincrement())
  consultation_id BigInt
  user_id         BigInt
  astrologer_id   BigInt
  start_time      DateTime?     @db.Timestamptz(6)
  end_time        DateTime?     @db.Timestamptz(6)
  total_minutes   Decimal?      @db.Decimal(10, 2)
  rate_per_minute Decimal       @db.Decimal(10, 2)
  total_amount    Decimal       @db.Decimal(18, 2)
  session_status  String        @db.VarChar(20)
  created_on      DateTime?     @default(now()) @db.Timestamptz(6)
  astrologers     astrologers   @relation(fields: [astrologer_id], references: [astrologer_id], onDelete: Cascade, onUpdate: NoAction)
  consultations   consultations @relation(fields: [consultation_id], references: [consultation_id], onDelete: NoAction, onUpdate: NoAction)
  users           users         @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
}

model user_devices {
  device_id    BigInt    @id @default(autoincrement())
  user_id      BigInt
  device_type  String?   @db.VarChar(20)
  device_token String?
  app_version  String?   @db.VarChar(20)
  login_time   DateTime? @default(now()) @db.Timestamptz(6)
  is_active    Boolean?  @default(true)
  users        users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
}

model user_login_history {
  login_history_id BigInt    @id @default(autoincrement())
  user_id          BigInt
  login_method     String?   @db.VarChar(20)
  ip_address       String?   @db.VarChar(50)
  device_name      String?   @db.VarChar(200)
  login_time       DateTime? @default(now()) @db.Timestamptz(6)
  logout_time      DateTime? @db.Timestamptz(6)
  users            users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
}

model user_otps {
  otp_id      BigInt    @id @default(autoincrement())
  user_id     BigInt?
  mobile_no   String    @db.VarChar(15)
  otp_code    String    @db.VarChar(10)
  purpose     String?   @db.VarChar(30)
  expires_on  DateTime  @db.Timestamptz(6)
  is_verified Boolean?  @default(false)
  created_on  DateTime? @default(now()) @db.Timestamptz(6)
  users       users?    @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
}

model user_permissions {
  permission_id    BigInt             @id @default(autoincrement())
  permission_code  String             @unique @db.VarChar(100)
  permission_name  String             @db.VarChar(200)
  role_permissions role_permissions[]
}

model user_refresh_tokens {
  refresh_token_id BigInt    @id @default(autoincrement())
  user_id          BigInt
  refresh_token    String    @db.VarChar(500)
  expires_on       DateTime  @db.Timestamptz(6)
  created_on       DateTime? @default(now()) @db.Timestamptz(6)
  revoked          Boolean?  @default(false)
  users            users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
}

model user_roles {
  user_role_id BigInt @id @default(autoincrement())
  user_id      BigInt
  role_id      Int    @db.SmallInt
  roles        roles  @relation(fields: [role_id], references: [role_id], onUpdate: NoAction)
  users        users  @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, role_id], map: "uq_user_roles")
}

model user_sessions {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id            BigInt
  device_id          String?   @db.VarChar(255)
  device_type        String?   @db.VarChar(20)
  device_name        String?   @db.VarChar(255)
  refresh_token_hash String    @db.VarChar(128)
  ip_address         String?   @db.VarChar(45)
  user_agent         String?
  expires_at         DateTime  @db.Timestamptz(6)
  last_active_at     DateTime  @default(now()) @db.Timestamptz(6)
  revoked_at         DateTime? @db.Timestamptz(6)
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  users              users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, device_id], map: "idx_sessions_device")
  @@index([refresh_token_hash], map: "idx_sessions_token_hash")
  @@index([user_id], map: "idx_sessions_user_id")
}

